# Copy to .env for local development. Real environment variables take precedence.

# Enables development conveniences. Must be false (or unset) in production.
DEBUG=true

# Required unless DEBUG=true. Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# Comma-separated host names the API may be served from.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated exact origins allowed to call the API (e.g. the Vercel frontend origin).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Comma-separated exact origins trusted for CSRF checks.
CSRF_TRUSTED_ORIGINS=

# Redirect HTTP to HTTPS. Defaults to true when DEBUG is false.
SECURE_SSL_REDIRECT=false

# HSTS max-age in seconds. Defaults to 0 in development and one year in production.
SECURE_HSTS_SECONDS=0

# Trust X-Forwarded-Proto from the hosting proxy. Enable only behind a trusted proxy.
TRUST_PROXY_SSL_HEADER=false

# Identifies this service to upstream providers. Public providers require a real contact.
UPSTREAM_USER_AGENT=WeatherAwareTruckRouting/0.1 (+https://github.com/syntrydy/truck-routing)

# Comma-separated hosts the API may call. Everything else is refused (SSRF guard).
UPSTREAM_ALLOWED_HOSTS=router.project-osrm.org,api.openrouteservice.org,api.open-meteo.com,photon.komoot.io,nominatim.openstreetmap.org

# Optional shared cache for several workers (for example redis://localhost:6379/0).
# Leave empty to use per-process memory.
REDIS_URL=

# Optional openrouteservice API key (free at https://openrouteservice.org). When set, it is used
# as the routing fallback if OSRM is unavailable. Leave empty to use OSRM only.
ORS_API_KEY=

# Top speed assumed for ETAs, in miles per hour. Segment times faster than this are slowed down.
TRUCK_MAX_SPEED_MPH=65

# Wind used for risk and the load rules: sustained (the brief's table) or gust.
RISK_WIND_BASIS=sustained

# Requests allowed per minute and client address (count/period, e.g. 10/m).
PLAN_RATE_LIMIT=10/m
GEOCODE_RATE_LIMIT=60/m

# Set to false to switch rate limiting off (for example in a private test environment).
RATE_LIMIT_ENABLED=true

# Number of reverse proxies in front of the API that append to X-Forwarded-For (Render: 1).
# Keep 0 when clients connect directly, because the header can be forged.
TRUSTED_PROXY_COUNT=0
